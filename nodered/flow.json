    "func": "const home = env.get('HOME') || env.get('USERPROFILE');\nconst historyDir = env.get('BIKEBEACON_HISTORY_DIR') || (home && home + '/.node-red/bikebeacon-history');\nif (!historyDir) return null;\nmsg.filename = historyDir + '/telemetry.jsonl';\nreturn msg;\n",
