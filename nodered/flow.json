  {
    "id": "a5f0c1d2e3b4030d",
    "type": "ui-template",
    "z": "a5f0c1d2e3b40001",
    "name": "Event history",
    "group": "a5f0c1d2e3b40310",
    "order": 1,
    "width": 4,
    "height": 0,
    "className": "",
    "x": 1200,
    "y": 810,
    "wires": [
      []
    ],
    "format": "<template>\n  <section class=\"bike-event-history\" aria-label=\"BikeBeacon event history\">\n    <a href=\"/bikebeacon/history/telemetry\" download=\"bikebeacon-telemetry.jsonl\">Download raw telemetry</a>\n    <div class=\"bike-event-tabs\" role=\"tablist\" aria-label=\"Event type\">\n      <button v-for=\"(tab, index) in tabs\" :key=\"tab.id\" type=\"button\" role=\"tab\"\n        :id=\"tabId(tab.id)\" :aria-controls=\"panelId\" :aria-selected=\"category === tab.id\"\n        :tabindex=\"category === tab.id ? 0 : -1\"\n        @click=\"selectTab(tab.id)\" @keydown=\"moveTab($event, index)\">\n        {{ tab.label }}\n      </button>\n    </div>\n\n    <div :id=\"panelId\" role=\"tabpanel\" :aria-labelledby=\"tabId(category)\" tabindex=\"0\">\n      <p v-if=\"loading && !records.length\" role=\"status\">Loading history…</p>\n      <p v-if=\"visibleErrors.length\" role=\"status\">Could not read {{ visibleErrors.join(', ') }} history. Retrying shortly.</p>\n      <p v-if=\"!loading && !visibleErrors.length && !records.length\">No events recorded yet.</p>\n\n      <template v-if=\"records.length\">\n        <p>{{ changeCount }} {{ changeCount === 1 ? 'change' : 'changes' }} · Los Angeles time</p>\n        <ol class=\"bike-event-list\" :start=\"firstIndex + 1\">\n          <li v-for=\"record in pageRecords\" :key=\"record.category + ':' + record.index\">\n            <div class=\"bike-event-heading\">\n              <span v-if=\"category === 'all'\" class=\"bike-event-type\" :class=\"'bike-type-' + record.category\">{{ eventLabel(record.category) }}</span>\n              <time :datetime=\"record.received_at\">{{ localTime(record.received_at) }}</time>\n            </div>\n            <div class=\"bike-event-transition\">\n              <span v-if=\"record.previous\" class=\"bike-event-value\" :class=\"stateClass(record.previous)\">{{ record.previous }}</span>\n              <span v-if=\"record.previous\" aria-label=\"to\">→</span>\n              <span v-else>Initial state</span>\n              <strong class=\"bike-event-value\" :class=\"stateClass(record.current)\">{{ record.current }}</strong>\n            </div>\n            <details v-if=\"reading(record)\">\n              <summary>Reading details</summary>\n              <p v-if=\"record.last_telemetry\">Last observed {{ localTime(record.last_telemetry.received_at) }}</p>\n              <dl class=\"bike-event-readings\">\n                <template v-for=\"(value, name) in reading(record)\" :key=\"name\">\n                  <dt>{{ fieldNames[name] || name }}</dt>\n                  <dd>{{ value }}</dd>\n                </template>\n              </dl>\n            </details>\n          </li>\n        </ol>\n        <nav v-if=\"pageCount > 1\" class=\"bike-event-pages\" aria-label=\"Event history pages\">\n          <button type=\"button\" :disabled=\"page === 0\" @click=\"page--\">Previous</button>\n          <span>Page {{ page + 1 }} of {{ pageCount }}</span>\n          <button type=\"button\" :disabled=\"page + 1 >= pageCount\" @click=\"page++\">Next</button>\n        </nav>\n      </template>\n    </div>\n  </section>\n</template>\n\n<script>\nexport default {\n    data() {\n        return {\n            tabs: [\n                { id: 'all', label: 'All' },\n                { id: 'connection', label: 'Connection' },\n                { id: 'motion', label: 'Motion' },\n                { id: 'system', label: 'System' },\n                { id: 'alarm', label: 'Alarm' }\n            ],\n            category: 'all',\n            archives: {},\n            errors: [],\n            page: 0,\n            pageSize: 5,\n            loading: true,\n            timer: null,\n            request: null,\n            fieldNames: {\n                seq: 'Sample', armed: 'Armed', moving: 'Moving', alarm: 'Alarm triggered',\n                motion_g: 'Acceleration (g)', rssi: 'Wi-Fi signal (dBm)', uptime_s: 'Uptime (seconds)'\n            }\n        }\n    },\n    computed: {\n        panelId() {\n            return 'bike-event-panel-' + this.id\n        },\n        records() {\n            if (this.category !== 'all') return this.archives[this.category] || []\n            return Object.values(this.archives).flat()\n                .sort((a, b) => b.received_at.localeCompare(a.received_at) || b.index - a.index)\n        },\n        visibleErrors() {\n            return this.errors.filter(id => this.category === 'all' || id === this.category).map(this.eventLabel)\n        },\n        changeCount() {\n            return this.records.filter(record => record.observation === 'change').length\n        },\n        firstIndex() {\n            return this.page * this.pageSize\n        },\n        pageRecords() {\n            return this.records.slice(this.firstIndex, this.firstIndex + this.pageSize)\n        },\n        pageCount() {\n            return Math.ceil(this.records.length / this.pageSize)\n        }\n    },\n    mounted() {\n        this.refresh()\n        this.timer = setInterval(() => {\n            if (!this.loading) this.refresh()\n        }, 30000)\n    },\n    unmounted() {\n        clearInterval(this.timer)\n        this.request?.abort()\n    },\n    methods: {\n        tabId(id) {\n            return 'bike-event-tab-' + this.id + '-' + id\n        },\n        eventLabel(id) {\n            return this.tabs.find(tab => tab.id === id)?.label || id\n        },\n        selectTab(id) {\n            this.category = id\n            this.page = 0\n        },\n        moveTab(event, index) {\n            const last = this.tabs.length - 1\n            const positions = {\n                ArrowLeft: index > 0 ? index - 1 : last,\n                ArrowRight: index < last ? index + 1 : 0,\n                Home: 0,\n                End: last\n            }\n            if (!(event.key in positions)) return\n            event.preventDefault()\n            const id = this.tabs[positions[event.key]].id\n            this.selectTab(id)\n            document.getElementById(this.tabId(id))?.focus()\n        },\n        reading(record) {\n            return record.telemetry || record.last_telemetry?.telemetry\n        },\n        localTime(timestamp) {\n            const date = new Date(timestamp)\n            if (typeof timestamp !== 'string' || Number.isNaN(date.valueOf())) return ''\n            return new Intl.DateTimeFormat('en-US', {\n                timeZone: 'America/Los_Angeles',\n                month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', second: '2-digit',\n                timeZoneName: 'short'\n            }).format(date)\n        },\n        stateClass(state) {\n            const colors = {\n                online: 'good', offline: 'bad', clear: 'good', triggered: 'bad',\n                moving: 'warning', armed: 'active', stationary: 'neutral', disarmed: 'neutral'\n            }\n            return 'bike-state-' + (colors[state.toLowerCase()] || 'neutral')\n        },\n        async readArchive(id, signal) {\n            const response = await fetch('/bikebeacon/history/' + id, { cache: 'no-store', signal })\n            if (response.status === 404) return { id, records: [], unreadable: false }\n            if (!response.ok) throw new Error('Unexpected history response')\n            const records = []\n            let unreadable = false\n            for (const line of (await response.text()).split('\\n')) {\n                if (!line.trim()) continue\n                try {\n                    const record = JSON.parse(line)\n                    if (typeof record?.received_at !== 'string' || typeof record.current !== 'string') {\n                        throw new Error('Invalid history record')\n                    }\n                    records.push({ ...record, category: id, index: records.length })\n                } catch {\n                    unreadable = true\n                }\n            }\n            return { id, records: records.reverse(), unreadable }\n        },\n        async refresh() {\n            this.request?.abort()\n            const request = new AbortController()\n            this.request = request\n            this.loading = true\n            const types = this.tabs.slice(1).map(tab => tab.id)\n            try {\n                const results = await Promise.allSettled(types.map(id => this.readArchive(id, request.signal)))\n                if (request.signal.aborted) return\n                const archives = { ...this.archives }\n                const errors = []\n                for (const [index, result] of results.entries()) {\n                    const id = types[index]\n                    if (result.status === 'fulfilled') {\n                        archives[id] = result.value.records\n                        if (result.value.unreadable) errors.push(id)\n                    } else {\n                        errors.push(id)\n                    }\n                }\n                this.archives = archives\n                this.errors = errors\n                this.page = Math.min(this.page, Math.max(0, this.pageCount - 1))\n            } finally {\n                if (!request.signal.aborted) this.loading = false\n            }\n        }\n    }\n}\n</script>\n\n<style>\n.bike-event-history { display: grid; gap: 0.75rem; padding: 0.5rem; }\n.bike-event-history p { margin: 0; font-size: 0.875rem; }\n.bike-event-tabs { display: flex; flex-wrap: wrap; gap: 0.25rem; }\n.bike-event-history button {\n    color: inherit; font: inherit; background: transparent; border: 1px solid currentColor;\n    border-radius: 0.3rem; padding: 0.25rem 0.45rem;\n}\n.bike-event-tabs button { font-size: 0.875rem; }\n.bike-event-tabs button[aria-selected=\"true\"] { font-weight: 700; background: rgba(127, 127, 127, 0.2); }\n.bike-event-history button:disabled { opacity: 0.45; }\n.bike-event-list { list-style: none; padding: 0; margin: 0.4rem 0; }\n.bike-event-list li { padding: 0.65rem 0; border-top: 1px solid rgba(127, 127, 127, 0.35); }\n.bike-event-heading, .bike-event-transition, .bike-event-pages {\n    display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.25rem 0.5rem;\n}\n.bike-event-heading { justify-content: space-between; }\n.bike-event-heading time { font-size: 0.8rem; font-variant-numeric: tabular-nums; }\n.bike-event-transition { margin: 0.35rem 0; font-size: 0.875rem; }\n.bike-event-type { border: 1px solid currentColor; padding: 0.08rem 0.35rem; font-size: 0.75rem; }\n.bike-type-connection { border-radius: 1rem; }\n.bike-type-motion { border-style: dashed; }\n.bike-type-system { border-radius: 0.25rem; }\n.bike-type-alarm { border-style: double; border-width: 3px; }\n.bike-event-value { border-radius: 0.25rem; padding: 0.08rem 0.35rem; }\n.bike-state-good { background: #d8f3e1; color: #135534; }\n.bike-state-bad { background: #fbe0df; color: #8a242a; }\n.bike-state-warning { background: #fff0c7; color: #6e4600; }\n.bike-state-active { background: #dceaff; color: #214881; }\n.bike-state-neutral { background: #eceef1; color: #384250; }\n.bike-event-readings { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.15rem 0.75rem; }\n.bike-event-readings dd { margin: 0; }\n.bike-state-row { display: flex; align-items: center; justify-content: space-between; height: 100%; gap: 0.35rem; }\n.bike-state-options { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.35rem; font-size: 0.8rem; }\n.bike-state-options .bike-event-value { white-space: nowrap; }\n.bike-state-selected { font-weight: 700; box-shadow: 0 0 0 1px currentColor; }\n</style>\n",
    "head": "",
    "noerr": 0,
    "storeOutMessages": false,
    "passthru": false,
    "resendOnRefresh": false,
    "templateScope": "local"
  },
