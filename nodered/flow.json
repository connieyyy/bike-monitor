    "type": "function",
    "z": "a5f0c1d2e3b40001",
    "name": "Resolve archive type",
    "func": "const home = env.get('HOME') || env.get('USERPROFILE');\nconst historyDir = env.get('BIKEBEACON_HISTORY_DIR') || (home && home + '/.node-red/bikebeacon-history');\nconst type = msg.req.params.type;\nconst allowed = ['telemetry', 'connection', 'motion', 'system', 'alarm'];\nif (!allowed.includes(type)) {\n    msg.statusCode = 404;\n    msg.payload = 'Unknown BikeBeacon history type.';\n    return [null, msg];\n}\nif (!historyDir) {\n    msg.statusCode = 500;\n    msg.payload = 'Set BIKEBEACON_HISTORY_DIR to a writable directory.';\n    return [null, msg];\n}\nmsg.filename = historyDir + '/' + type + '.jsonl';\nmsg.headers = { 'content-type': 'text/plain; charset=utf-8', 'cache-control': 'no-store' };\nreturn [msg, null];\n",
