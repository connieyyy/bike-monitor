  {
    "id": "a5f0c1d2e3b4010c",
    "type": "function",
    "z": "a5f0c1d2e3b40001",
    "name": "Record telemetry and state changes",
    "func": "const home = env.get('HOME') || env.get('USERPROFILE');\nconst historyDir = env.get('BIKEBEACON_HISTORY_DIR') || (home && home + '/.node-red/bikebeacon-history');\nif (!historyDir) {\n    node.error('Set BIKEBEACON_HISTORY_DIR to a writable directory.', msg);\n    return null;\n}\nconst received_at = new Date().toISOString();\nconst state = context.get('device') || { states: {}, latest: null };\nconst records = [];\nlet alert = null;\n\nfunction record(file, data) {\n    records.push({ filename: historyDir + '/' + file + '.jsonl', payload: data });\n}\n\nfunction observe(type, current, details) {\n    const previous = state.states[type] ?? null;\n    if (previous === current) return previous;\n    state.states[type] = current;\n    record(type, { received_at, observation: previous === null ? 'initial' : 'change', previous, current, ...details });\n    return previous;\n}\n\nif (msg.topic === 'iot/T04/telemetry') {\n    const telemetry = msg.payload;\n    record('telemetry', { received_at, topic: msg.topic, telemetry });\n    if (telemetry && typeof telemetry === 'object') {\n        state.latest = { received_at, telemetry };\n        const states = {\n            motion: [telemetry.moving, 'Moving', 'Stationary'],\n            system: [telemetry.armed, 'Armed', 'Disarmed'],\n            alarm: [telemetry.alarm, 'Triggered', 'Clear']\n        };\n        for (const [type, [value, on, off]] of Object.entries(states)) {\n            if (typeof value === 'boolean') observe(type, value ? on : off, { telemetry });\n        }\n    }\n} else if (msg.topic === 'iot/T04/status' && ['online', 'offline'].includes(msg.payload)) {\n    const previous = observe('connection', msg.payload, {\n        retained: msg.retain === true,\n        last_telemetry: state.latest\n    });\n    if (previous === 'online' && msg.payload === 'offline') {\n        alert = { payload: 'BikeBeacon went offline at ' + received_at };\n    }\n}\n\ncontext.set('device', state);\nreturn [records.length ? records : null, alert];\n",
