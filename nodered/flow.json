  {
    "id": "a5f0c1d2e3b40203",
    "z": "a5f0c1d2e3b40001",
    "name": "System",
    "group": "a5f0c1d2e3b40013",
    "order": 8,
    "width": 4,
    "height": 1,
    "className": "",
    "x": 400,
    "y": 240,
    "type": "ui-template",
    "format": "<template>\n  <div class=\"bike-state-row\">\n    <span>{{ label }}</span>\n    <div class=\"bike-state-options\" :aria-label=\"activeLabel\">\n      <span v-for=\"option in options\" :key=\"option.label\" class=\"bike-event-value\"\n        :class=\"['bike-state-' + option.color, { 'bike-state-selected': current === option.value }]\"\n        :aria-current=\"current === option.value ? 'true' : undefined\">{{ option.label }}</span>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n    data() {\n        return { label: \"System\", field: \"armed\", options: [{\"value\": true, \"label\": \"Armed\", \"color\": \"active\"}, {\"value\": false, \"label\": \"Disarmed\", \"color\": \"neutral\"}], lastConnection: null }\n    },\n    computed: {\n        current() {\n            const payload = this.msg?.payload\n            if (this.field === 'connection') {\n                return payload === 'online' || payload === 'offline' ? payload : this.lastConnection\n            }\n            return payload?.[this.field]\n        },\n        activeLabel() {\n            const selected = this.options.find(option => option.value === this.current)\n            return selected ? this.label + ': ' + selected.label : this.label + ': waiting for data'\n        }\n    },\n    async mounted() {\n        if (this.field !== 'connection' || this.current !== null) return\n        try {\n            const response = await fetch('/bikebeacon/history/connection', { cache: 'no-store' })\n            if (!response.ok) return\n            const line = (await response.text()).trim().split('\\n').pop()\n            if (line) this.lastConnection = JSON.parse(line).current\n        } catch {\n            // The live status still updates when MQTT sends its next value.\n        }\n    }\n}\n</script>",
    "head": "",
    "noerr": 0,
    "storeOutMessages": false,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "wires": [
      []
    ]
  },
