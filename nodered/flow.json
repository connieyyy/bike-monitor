  {
    "id": "a5f0c1d2e3b40305",
    "type": "function",
    "z": "a5f0c1d2e3b40001",
    "name": "Summarize each minute",
    "func": "const windows = new Map();\nfor (const line of msg.payload.split('\\n')) {\n    if (!line.trim()) continue;\n    let row;\n    try {\n        row = JSON.parse(line);\n    } catch (err) {\n        continue;\n    }\n    const timestamp = Date.parse(row.received_at);\n    if (!Number.isFinite(timestamp) || !row.telemetry) continue;\n    const minute = Math.floor(timestamp / 60000) * 60000;\n    if (!windows.has(minute)) windows.set(minute, {});\n    const bucket = windows.get(minute);\n    for (const field of ['motion_g', 'rssi']) {\n        const value = row.telemetry[field];\n        if (!Number.isFinite(value)) continue;\n        const samples = bucket[field] ??= { count: 0, sum: 0, min: value, max: value };\n        samples.count++;\n        samples.sum += value;\n        samples.min = Math.min(samples.min, value);\n        samples.max = Math.max(samples.max, value);\n    }\n}\n\nfunction seriesFor(field, extreme, extremeLabel) {\n    const points = [];\n    for (const [minute, fields] of windows) {\n        const samples = fields[field];\n        if (!samples) continue;\n        const average = Math.round(samples.sum / samples.count * 100) / 100;\n        points.push({ minute, series: 'Average', value: average });\n        points.push({ minute, series: extremeLabel, value: samples[extreme] });\n    }\n    return { action: 'replace', payload: points };\n}\nreturn [seriesFor('motion_g', 'max', 'Peak'), seriesFor('rssi', 'min', 'Weakest')];\n",
