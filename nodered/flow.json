    "func": "const missing = /ENOENT/.test(msg.error?.message || '');\nif (!msg.res) {\n    if (!missing) node.warn(msg.error?.message || 'Could not refresh the history charts.');\n    return null;\n}\nmsg.statusCode = missing ? 404 : 500;\nmsg.payload = missing ? 'No BikeBeacon history has been recorded for this type yet.' : 'Could not read BikeBeacon history.';\nreturn msg;\n",
